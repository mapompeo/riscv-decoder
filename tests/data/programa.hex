# Programa de teste: ao menos uma instrucao de cada formato (R, I, S, B, U, J),
# um desvio com deslocamento negativo e uma palavra invalida.
# Formato: hexadecimal, uma instrucao por linha.

0x00500413   # addi s0, zero, 5            -> tipo I
0x00000593   # addi a1, zero, 0            -> pseudo li / tipo I
0x123452B7   # lui t0, 0x12345             -> tipo U
0x00001317   # auipc t1, 0x1               -> tipo U
0x00C58633   # add a2, a1, a2              -> tipo R
0x40B606B3   # sub a3, a2, a1              -> tipo R (funct7 = 0x20)
0x0064A423   # sw t1, 8(s1)                -> tipo S (sem rd)
0x0084A703   # lw a4, 8(s1)                -> tipo I (load)
0x40275793   # srai a5, a4, 2              -> tipo I (funct7 separa srai de srli)
0xFE628CE3   # beq t0, t1, -8              -> tipo B com deslocamento NEGATIVO
0x00B56463   # bltu a0, a1, +8             -> tipo B
0x008000EF   # jal ra, +8                  -> tipo J
0xFF1FF06F   # jal zero, -16               -> tipo J negativo (pseudo j)
0x00008067   # jalr zero, 0(ra)            -> pseudo ret
0x00000013   # addi zero, zero, 0          -> pseudo nop
0x00000073   # ecall                       -> sistema
0xFFFFFFFF   # palavra invalida            -> deve ser reportada sem parar
