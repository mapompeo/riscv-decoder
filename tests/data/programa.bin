# Mesmo programa do arquivo .hex, agora em binario (32 bits por linha).
# Serve para conferir a deteccao automatica de formato exigida no R1.

00000000010100000000010000010011  // addi s0, zero, 5            -> tipo I
00000000000000000000010110010011  // addi a1, zero, 0            -> pseudo li / tipo I
00010010001101000101001010110111  // lui t0, 0x12345             -> tipo U
00000000000000000001001100010111  // auipc t1, 0x1               -> tipo U
00000000110001011000011000110011  // add a2, a1, a2              -> tipo R
01000000101101100000011010110011  // sub a3, a2, a1              -> tipo R (funct7 = 0x20)
00000000011001001010010000100011  // sw t1, 8(s1)                -> tipo S (sem rd)
00000000100001001010011100000011  // lw a4, 8(s1)                -> tipo I (load)
01000000001001110101011110010011  // srai a5, a4, 2              -> tipo I (funct7 separa srai de srli)
11111110011000101000110011100011  // beq t0, t1, -8              -> tipo B com deslocamento NEGATIVO
00000000101101010110010001100011  // bltu a0, a1, +8             -> tipo B
00000000100000000000000011101111  // jal ra, +8                  -> tipo J
11111111000111111111000001101111  // jal zero, -16               -> tipo J negativo (pseudo j)
00000000000000001000000001100111  // jalr zero, 0(ra)            -> pseudo ret
00000000000000000000000000010011  // addi zero, zero, 0          -> pseudo nop
00000000000000000000000001110011  // ecall                       -> sistema
11111111111111111111111111111111  // palavra invalida            -> deve ser reportada sem parar
